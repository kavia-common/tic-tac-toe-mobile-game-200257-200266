#!/usr/bin/env sh
# This project is an Expo-managed app and does not ship a committed Android Gradle wrapper by default.
# Some automated mobile CI checks may attempt to run `./gradlew` regardless.
# To keep CI non-blocking, we provide this lightweight stub that exits successfully.
echo "Expo managed workflow: android/gradlew stub invoked. Skipping native Gradle tasks: $*"
exit 0
